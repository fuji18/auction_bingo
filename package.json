{
  "name": "auction-bingo",
  "version": "0.1.0",
  "description": "オークション・ビンゴ — 確率を金で買う対戦型ボードゲーム (Vite + Svelte 5 + TypeScript の静的Webアプリ)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "sim": "node --import ./scripts/register-loader.mjs src/sim/run.ts"
  },
  "keywords": [
    "board-game",
    "bingo",
    "auction",
    "svelte",
    "typescript"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "husky": "^9.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "secretlint": "^13.0.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*": [
      "secretlint"
    ]
  }
}
